{
  "info": {
    "name": "PlanWith FO User Backend - Auth",
    "_postman_id": "b3f8c2e0-fo-user-auth-collection",
    "description": "회원가입/로그인/탈퇴 등 인증 관련 API 테스트용 컬렉션. baseUrl 변수만 바꾸면 됩니다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" }
  ],
  "item": [
    {
      "name": "1. 이메일 중복확인",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/auth/check-email?email=test@example.com"
      }
    },
    {
      "name": "2. 닉네임 중복확인",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/auth/check-nickname?nickname=여행자"
      }
    },
    {
      "name": "3. 약관 목록 조회",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/terms"
      }
    },
    {
      "name": "4. 이메일 인증코드 발송 (mock 모드면 서버 콘솔 로그 확인)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/email/send",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\"\n}"
        }
      }
    },
    {
      "name": "5. 이메일 인증코드 확인 (콘솔에서 본 code로 교체)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/email/verify",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"code\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "6. 회원가입",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/signup",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Test1234!\",\n  \"nickname\": \"여행자\",\n  \"introduction\": \"안녕하세요\",\n  \"agreedTermIds\": [1, 2, 3]\n}"
        }
      }
    },
    {
      "name": "7. 로그인 (응답의 accessToken/refreshToken을 변수에 저장해서 다음 요청에 사용)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Test1234!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "if (body.data) {",
              "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
              "  pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "8. 토큰 재발급",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/reissue",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        }
      }
    },
    {
      "name": "9. 로그아웃 (인증 필요)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/api/auth/logout"
      }
    },
    {
      "name": "10. 비밀번호 재설정",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/password/reset",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"code\": \"123456\",\n  \"newPassword\": \"NewPass1234!\"\n}"
        }
      }
    },
    {
      "name": "11. 회원탈퇴 (인증 필요)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/auth/withdraw",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"Test1234!\"\n}"
        }
      }
    }
  ]
}
