# Required shared with Gateway
GATEWAY_INTERNAL_TOKEN=local-gateway-internal-token
GATEWAY_TRUST_CHECK_ENABLED=true

# Eureka (Discovery)
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
EUREKA_INSTANCE_ID=

# Database / infra
DB_URL=jdbc:mysql://localhost:3306/planwith?serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=password
REDIS_HOST=localhost
REDIS_PORT=6379
MONGODB_URI=mongodb://localhost:27017/planwith
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT issuance (local may omit PEM and use ephemeral keys)
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=planwith-api
JWT_KEY_ID=fo-user-be-key-1
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=

# Gmail SMTP (put real values only in gitignored .env)
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_MOCK_MODE=false
