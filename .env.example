# Required shared with Gateway
GATEWAY_INTERNAL_TOKEN=local-gateway-internal-token
GATEWAY_TRUST_CHECK_ENABLED=true

# Eureka (Discovery)
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
EUREKA_INSTANCE_ID=

# Database / infra
DB_URL=jdbc:mysql://localhost:3306/planwith?serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=password
REDIS_HOST=localhost
REDIS_PORT=6379
MONGODB_URI=mongodb://localhost:27017/planwith
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT issuance (local may omit PEM and use ephemeral keys)
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=planwith-api
JWT_KEY_ID=fo-user-be-key-1
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=

# Gmail SMTP (put real values only in gitignored .env)
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_MOCK_MODE=false

# Profile image storage (local disk by default; set AWS_S3_ENABLED=true for S3)
AWS_S3_ENABLED=false
AWS_S3_BUCKET=
AWS_S3_KEY_PREFIX=profile-images/
AWS_S3_PUBLIC_BASE_URL=
AWS_S3_PUBLIC_READ_ACL=false
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REKOGNITION_ENABLED=false
REKOGNITION_THRESHOLD=70

# Social OAuth (needed when FE sends authorizationCode instead of accessToken)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=
