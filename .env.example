# Required
DB_URL=jdbc:mysql://localhost:3306/planwith?serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
MONGODB_URI=mongodb://localhost:27017/planwith
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
EUREKA_INSTANCE_ID=
GATEWAY_INTERNAL_TOKEN=change-me-gateway-internal-token
GATEWAY_TRUST_CHECK_ENABLED=true
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=planwith-api
JWT_KEY_ID=fo-user-be-key-1
JWT_PRIVATE_KEY_PATH=/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/secrets/jwt-public.pem
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=14d
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_PATH=/api/v1/auth

# Optional / local
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_MOCK_MODE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
REKOGNITION_ENABLED=false
FILE_UPLOAD_DIR=/tmp/planwith-uploads
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
